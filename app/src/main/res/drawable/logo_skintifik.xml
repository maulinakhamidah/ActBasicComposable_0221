<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Outer Circular Gradient Ring -->
    <path
        android:pathData="M 100,10 A 90,90 0 1,0 100,190 A 90,90 0 1,0 100,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="10"
                android:startY="10"
                android:endX="190"
                android:endY="190"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF4DD0E1"/>
                <item android:offset="0.5" android:color="#FF80DEEA"/>
                <item android:offset="1.0" android:color="#FFF48FB1"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner White Circle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 100,18 A 82,82 0 1,0 100,182 A 82,82 0 1,0 100,18 Z" />

    <!-- Skintifik Crystal Shield Emblem -->
    <path
        android:pathData="M 100,45 L 135,65 L 135,110 C 135,135 100,155 100,155 C 100,155 65,135 65,110 L 65,65 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="65"
                android:startY="45"
                android:endX="135"
                android:endY="155"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00B4D8"/>
                <item android:offset="0.6" android:color="#FF0077B6"/>
                <item android:offset="1.0" android:color="#FF7209B7"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5X Ceramide Molecular Cross Sparkle inside Shield -->
    <!-- Central Diamond -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 100,75 L 115,100 L 100,125 L 85,100 Z"/>

    <!-- Inner Cyan Accent Diamond -->
    <path
        android:fillColor="#80E0F7FA"
        android:pathData="M 100,83 L 110,100 L 100,117 L 90,100 Z"/>

    <!-- Sparkles Top Right -->
    <path
        android:fillColor="#FFD1C4E9"
        android:pathData="M 148,45 L 152,55 L 162,59 L 152,63 L 148,73 L 144,63 L 134,59 L 144,55 Z"/>

    <!-- Sparkles Bottom Left -->
    <path
        android:fillColor="#FFB2EBF2"
        android:pathData="M 52,125 L 55,132 L 62,135 L 55,138 L 52,145 L 49,138 L 42,135 L 49,132 Z"/>
</vector>
