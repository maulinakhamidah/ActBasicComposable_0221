        android:pathData="M 70,113 L 130,113 L 130,118 L 70,118 Z"/>
    <path
        android:fillColor="#FFB2EBF2"
        android:pathData="M 78,124 L 122,124 L 122,128 L 78,128 Z"/>
    <path
