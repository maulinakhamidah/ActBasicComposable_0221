                android:startY="65"
                android:endX="165"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF"/>
                <item android:offset="0.5" android:color="#FFE0F7FA"/>
                <item android:offset="1.0" android:color="#FFB2EBF2"/>
            </gradient>
        </aapt:attr>
