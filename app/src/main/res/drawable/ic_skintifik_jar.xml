            <gradient
                android:startX="40"
                android:startY="85"
                android:endX="160"
                android:endY="164"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D4FF"/>
                <item android:offset="0.5" android:color="#FF0099FF"/>
                <item android:offset="1.0" android:color="#FF6B11FF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass Reflection Highlight on Jar -->
    <path
        android:pathData="M 55,92 L 75,92 L 68,155 L 58,150 Z">
        <aapt:attr name="android:fillColor">
            <gradient
